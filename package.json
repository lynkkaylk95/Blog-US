{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "postinstall": "node scripts/sync-tinymce.mjs",
    "content:check": "vinext build",
    "test": "vinext build && node --test tests/rendered-html.test.mjs",
    "test:series": "tsx --test tests/series-input.test.ts",
    "test:series:api": "node --test tests/series-api.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply porchlight-stories --local",
    "db:migrate:remote": "wrangler d1 migrations apply porchlight-stories --remote"
  },
  "dependencies": {
    "@tinymce/tinymce-react": "^6.3.0",
    "domhandler": "5.0.3",
    "drizzle-orm": "0.45.2",
    "htmlparser2": "10.1.0",
    "next": "16.3.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sanitize-html": "^2.17.7",
    "tinymce": "8.5.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "browserslist": "4.29.0"
  },
  "type": "module"
}
